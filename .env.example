# LLM API key (required) — OpenRouter by default: https://openrouter.ai/keys
# Any OpenAI-compatible provider works when paired with LLM_BASE_URL below.
LLM_API_KEY=your-api-key

# Optional overrides (defaults shown)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# LLM_MODEL=google/gemini-3.8-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_HTTP_REFERER=https://your-app.example.com
# LLM_TEMPERATURE=0.7
# WHISPER_MODEL=base
# QDRANT_URL=http://qdrant:6333
# MEMORY_COLLECTION=user_memory
# MEMORY_TOP_K=5
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ALLOWED_ORIGINS=*
# MAX_AUDIO_BYTES=26214400
